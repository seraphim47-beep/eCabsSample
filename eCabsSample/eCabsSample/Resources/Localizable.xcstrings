    "about.supported_events.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monitor 16 types of GitHub events, including commits, branch and tag creation and deletion, discussions, forks, wiki updates, issue and pull request activity, reviews, pushes, releases, and collaborator additions."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monitora 16 tipologie di eventi GitHub: commit, creazione ed eliminazione di branch e tag, discussioni, fork, aggiornamenti wiki, commenti e attività su issue e pull request, revisioni, push, release e aggiunta di collaboratori."
          }
        }
      }
    },
